{
  "schemaVersion": 1,
  "libraryVersion": "3.3.14",
  "sourceOfTruth": true,
  "basePath": "./assets/evolutions/",
  "protectedMovementRule": "Never edit, overwrite, regenerate, rename, or remove files in sanctuary/assets/motion/. The original 33 movement files remain the stable movement fallback.",
  "stageOrder": [
    "new-bond",
    "apprentice",
    "guardian",
    "ascendant",
    "celestial"
  ],
  "stages": {
    "new-bond": {
      "displayName": "New Bond",
      "minLevel": 1,
      "maxLevel": 2,
      "accent": "soft moonlight"
    },
    "apprentice": {
      "displayName": "Apprentice",
      "minLevel": 3,
      "maxLevel": 4,
      "accent": "violet learning glow"
    },
    "guardian": {
      "displayName": "Guardian",
      "minLevel": 5,
      "maxLevel": 7,
      "accent": "focused celestial aura"
    },
    "ascendant": {
      "displayName": "Ascendant",
      "minLevel": 8,
      "maxLevel": 11,
      "accent": "gold-violet orbit magic"
    },
    "celestial": {
      "displayName": "Celestial",
      "minLevel": 12,
      "maxLevel": null,
      "accent": "full moon-and-star radiance"
    }
  },
  "actions": {
    "walk": {
      "role": "stage-aware locomotion visual",
      "interactive": false
    },
    "play": {
      "role": "Guardian interaction/reaction visual",
      "interactive": false
    },
    "sleep": {
      "role": "rest/bed visual",
      "interactive": false
    }
  },
  "loadingPolicy": {
    "preload": "current Guardian stage assets",
    "lazyLoad": "other stages on profile/evolution view",
    "missingAssetFallback": "protected original movement art",
    "cacheKeyPattern": "evo-{guardian}-{stage}-{action}"
  },
  "renderPolicy": {
    "movementScheduler": "protected-existing",
    "behaviorMethods": "protected-existing",
    "stageSelection": "level-driven",
    "actionSelection": "behavior-driven",
    "visualSwapOnly": true,
    "neverStretchPortraitIntoMovementFrame": true
  },
  "levelResolution": [
    {
      "stage": "new-bond",
      "minLevel": 1,
      "maxLevel": 2
